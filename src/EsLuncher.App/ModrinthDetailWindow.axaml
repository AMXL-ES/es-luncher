<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EsLuncher.App"
        x:Class="EsLuncher.App.ModrinthDetailWindow"
        Title="详情"
        Width="760"
        Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E12">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="20" RowSpacing="10">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Width="56" Height="56" CornerRadius="12" Background="#262631">
        <Image x:Name="IconImage" Width="56" Height="56" />
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="MetaText" FontSize="12" Foreground="#9A9AA3" />
      </StackPanel>
      <TextBlock Grid.Column="2" x:Name="DownloadsText" FontSize="12" Foreground="#6E6E76" VerticalAlignment="Center" />
    </Grid>

    <TextBlock x:Name="CategoriesText" Grid.Row="1" FontSize="11" Foreground="#6E6E76" TextWrapping="Wrap" />

    <TextBlock Grid.Row="2" Text="简介" Foreground="#9A9AA3" FontSize="12" />
    <Border Grid.Row="3" Background="#141419" CornerRadius="10" Padding="12">
      <ScrollViewer>
        <TextBox x:Name="DescriptionBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#D0D0D6" FontSize="12" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="4" Text="可用版本" Foreground="#9A9AA3" FontSize="12" />
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
      <Border Background="#141419" CornerRadius="10" Padding="8">
        <ListBox x:Name="VersionsList" Height="110" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:VersionInfoItem">
              <TextBlock Text="{Binding Label}" Foreground="#D0D0D6" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8" VerticalAlignment="Center">
        <TextBox x:Name="InstanceNameBox" Width="180" PlaceholderText="新实例名" IsVisible="False" />
        <Button x:Name="InstallButton" Content="安装选中版本" Classes="primary" Click="OnInstallClick" />
        <Button Content="关闭" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#9A9AA3" FontSize="11" TextWrapping="Wrap" />
  </Grid>
</Window>
