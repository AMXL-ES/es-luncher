<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EsLuncher.App"
        x:Class="EsLuncher.App.MainWindow"
        Title="ES Luncher"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12"
        KeyboardNavigation.TabNavigation="Cycle">
  <Window.Styles>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#23232B" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A2A34" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B8B8C2" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#23232B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4C8DF6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#5F9AF8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#23232B" />
      <Setter Property="Foreground" Value="#D0D0D6" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#2C2C36" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="56,*,30">
    <!-- 顶栏 -->
    <Border Grid.Row="0" Background="#131318" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True">
            <Image x:Name="HeaderLogo" Width="30" Height="30" Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="ES Luncher" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
          <TextBlock Text="Endless Studio" FontSize="11" Foreground="#6E6E76" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="NavHomeButton" Classes="nav" Content="主页" Tag="home" Click="OnNavClick" AutomationProperties.Name="{app:T nav.home}" />
          <Button x:Name="NavInstancesButton" Classes="nav" Content="实例" Tag="instances" Click="OnNavClick" AutomationProperties.Name="{app:T nav.instances}" />
          <Button x:Name="NavDownloadsButton" Classes="nav" Content="下载" Tag="downloads" Click="OnNavClick" AutomationProperties.Name="{app:T nav.downloads}" />
          <Button x:Name="NavOthersButton" Classes="nav" Content="其他" Tag="others" Click="OnNavClick" AutomationProperties.Name="{app:T nav.others}" />
          <Button x:Name="NavSettingsButton" Classes="nav" Content="设置" Tag="settings" Click="OnNavClick" AutomationProperties.Name="{app:T nav.settings}" />
          <Button x:Name="NavAboutButton" Classes="nav" Content="关于" Tag="about" Click="OnNavClick" AutomationProperties.Name="{app:T nav.about}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="HeaderVersionText" FontSize="11" Foreground="#5C5C64" VerticalAlignment="Center" />
          <Button x:Name="AccountButton" Classes="nav" Click="OnAccountsClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="24" Height="24" CornerRadius="12" Background="#4C8DF6">
                <TextBlock x:Name="AccountInitial" Text="P" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="AccountName" Text="离线 · Player" FontSize="12" Foreground="#D0D0D6" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 页面 -->
    <Grid Grid.Row="1">
      <!-- 主页 -->
      <Grid x:Name="HomePage" ClipToBounds="True">
        <Border x:Name="HomeBackground">
          <Grid>
            <TextBlock x:Name="HomeWatermark" FontSize="360" FontWeight="Bold" Foreground="#1CFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border VerticalAlignment="Bottom" Height="260">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#CC000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,34" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock x:Name="HomeName" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <Button x:Name="InstancePickerButton" Content="▲" Classes="ghost" Width="34" Height="34" Padding="0,2"
                    FontSize="12" Click="OnInstancePickerClick" />
          </StackPanel>

          <Button x:Name="HomeLaunchButton" Classes="primary" Content="{app:T home.launch}" AutomationProperties.Name="{app:T home.launch}" FontSize="18" Padding="40,12"
                  HorizontalAlignment="Right" Click="OnLaunchClick" />

          <TextBlock x:Name="HomeVersionLabel" FontSize="12" Foreground="#B0B0BA"
                     HorizontalAlignment="Right" TextAlignment="Right" />
        </StackPanel>

        <Popup x:Name="InstancePopup" Placement="Top" PlacementTarget="{Binding #InstancePickerButton}" IsOpen="False">
          <Border Background="#1A1A22" CornerRadius="10" Padding="8" Width="280">
            <ListBox x:Name="HomeInstanceList" Background="Transparent" SelectionChanged="OnHomeInstanceSelected">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:InstanceItem">
                  <Border Padding="8" CornerRadius="6">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Version}" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Grid>

      <!-- 实例页 -->
      <Grid x:Name="InstancesPage" IsVisible="False" Margin="24,18" ColumnDefinitions="*,396" RowDefinitions="Auto,Auto,*" ColumnSpacing="16">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{app:T instances.title}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock x:Name="InstancesSummary" FontSize="12" Foreground="#6E6E76" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Classes="ghost" Content="{app:T toolbar.refresh}" Click="OnRefreshClick" AutomationProperties.Name="{app:T toolbar.refresh}" />
            <Button x:Name="OpenFolderButton" Classes="ghost" Content="{app:T toolbar.open}" Click="OnOpenFolderClick" AutomationProperties.Name="{app:T toolbar.open}" />
            <Button x:Name="DiagnosticsButton" Classes="ghost" Content="{app:T toolbar.diagnostics}" Click="OnDiagnosticsClick" AutomationProperties.Name="{app:T toolbar.diagnostics}" />
            <Button x:Name="LogButton" Classes="ghost" Content="{app:T toolbar.logs}" Click="OnLogClick" AutomationProperties.Name="{app:T toolbar.logs}" />
            <Button x:Name="LaunchButton" Classes="primary" Content="{app:T toolbar.launch.short}" Click="OnLaunchClick" AutomationProperties.Name="{app:T toolbar.launch}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
          <TextBox x:Name="SearchBox" PlaceholderText="{app:T search.placeholder}" TextChanged="OnSearchChanged" />
          <ComboBox x:Name="GroupBox" Grid.Column="1" Width="150" Margin="10,0,0,0" SelectionChanged="OnGroupChanged" />
        </Grid>

        <Panel Grid.Row="2" Margin="0,12,0,0">
        <ListBox x:Name="InstanceList" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnInstanceSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:InstanceItem">
              <Border Width="288" Margin="0,0,12,12" Background="#1A1A22" CornerRadius="12" Padding="14">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="44" Height="44" CornerRadius="11" Background="#262631" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8A8A93" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

          <StackPanel x:Name="InstancesEmptyState" IsVisible="False" Spacing="10"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{app:T instances.empty}" FontSize="15" Foreground="#9A9AA3" HorizontalAlignment="Center" />
            <TextBlock Text="{app:T instances.emptyHint}" FontSize="12" Foreground="#5C5C64" HorizontalAlignment="Center" />
            <Button Content="{app:T instances.emptyAction}" Classes="primary" HorizontalAlignment="Center" Click="OnGoDownloadsClick" />
          </StackPanel>
        </Panel>

        <!-- 内容面板 -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="0,14,0,0" Background="#141419" CornerRadius="12" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock x:Name="ContentTitle" Text="内容" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
              <ComboBox x:Name="ContentKindBox" SelectedIndex="0" Width="104" Margin="0,0,8,6" SelectionChanged="OnContentKindChanged">
                <ComboBoxItem Content="mods" />
                <ComboBoxItem Content="{app:T kind.resourcepacks}" />
                <ComboBoxItem Content="{app:T kind.shaders}" />
                <ComboBoxItem Content="{app:T kind.worlds}" />
                <ComboBoxItem Content="{app:T kind.datapacks}" />
                <ComboBoxItem Content="{app:T kind.screenshots}" />
              </ComboBox>
              <ComboBox x:Name="WorldBox" Width="140" Margin="0,0,8,6" IsVisible="False" SelectionChanged="OnWorldChanged" />
              <Button Content="{app:T content.add}" AutomationProperties.Name="{app:T content.add}" Classes="ghost" Margin="0,0,8,6" Click="OnAddContentClick" />
              <Button Content="{app:T content.toggle}" AutomationProperties.Name="{app:T content.toggle}" Classes="ghost" Margin="0,0,8,6" Click="OnToggleContentClick" />
              <Button Content="{app:T content.remove}" AutomationProperties.Name="{app:T content.remove}" Classes="ghost" Margin="0,0,8,6" Click="OnRemoveContentClick" />
              <Button Content="{app:T content.folder}" AutomationProperties.Name="{app:T content.folder}" Classes="ghost" Margin="0,0,8,6" Click="OnOpenContentFolderClick" />
              <Button Content="{app:T content.download}" AutomationProperties.Name="{app:T content.download}" Classes="ghost" Margin="0,0,8,6" Click="OnDownloadContentClick" />
              <Button x:Name="MoveUpButton" Content="{app:T content.up}" AutomationProperties.Name="{app:T content.up}" Classes="ghost" Margin="0,0,8,6" Click="OnMoveUpClick" IsVisible="False" />
              <Button x:Name="MoveDownButton" Content="{app:T content.down}" AutomationProperties.Name="{app:T content.down}" Classes="ghost" Margin="0,0,8,6" Click="OnMoveDownClick" IsVisible="False" />
              <Button x:Name="CheckUpdatesButton" Content="{app:T content.checkUpdates}" AutomationProperties.Name="{app:T content.checkUpdates}" Classes="ghost" Margin="0,0,8,6" Click="OnCheckUpdatesClick" />
              <Button x:Name="BackupWorldButton" Content="{app:T content.backupWorld}" AutomationProperties.Name="{app:T content.backupWorld}" Classes="ghost" Margin="0,0,8,6" Click="OnBackupWorldClick" IsVisible="False" />
            </WrapPanel>

            <ListBox x:Name="ContentList" Grid.Row="2" Margin="0,8,0,0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:ContentItem">
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ContentStatus" Grid.Row="4" Margin="0,6,0,0" Foreground="#6E6E76" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </Grid>

      <ContentControl x:Name="DownloadsHost" IsVisible="False" Margin="24,18" />
      <ContentControl x:Name="SettingsHost" IsVisible="False" Margin="24,18" />

      <!-- 其他 -->
      <Grid x:Name="OthersPage" IsVisible="False" Margin="24,18">
        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="{app:T others.title}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />

          <Border Background="#141419" CornerRadius="12" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="{app:T others.current}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
              <TextBlock x:Name="OthersInstanceText" Foreground="#9A9AA3" FontSize="12" />
              <WrapPanel>
                <Button Content="{app:T others.accounts}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersAccountsClick" />
                <Button Content="{app:T others.diagnostics}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersDiagnosticsClick" />
                <Button Content="{app:T others.logs}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersLogClick" />
                <Button Content="{app:T others.openInstance}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenInstanceClick" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="#141419" CornerRadius="12" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="{app:T others.tools}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
              <WrapPanel>
                <Button Content="{app:T others.openData}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenDataClick" />
                <Button Content="{app:T others.openLogs}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenLogsClick" />
                <Button Content="{app:T others.openCache}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenCacheClick" />
                <Button Content="{app:T others.openTrash}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenTrashClick" />
                <Button Content="{app:T others.clearTrash}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersClearTrashClick" />
              </WrapPanel>
              <WrapPanel>
                <Button Content="{app:T others.guide}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersOpenGuideClick" />
                <Button Content="{app:T others.about}" Classes="ghost" Margin="0,0,8,8" Click="OnOthersAboutClick" />
              </WrapPanel>
              <TextBlock x:Name="OthersStatus" Foreground="#6E6E76" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#141419" CornerRadius="12" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="{app:T others.update}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
              <TextBlock x:Name="UpdateVersionText" Foreground="#9A9AA3" FontSize="12" />
              <WrapPanel>
                <Button x:Name="UpdateCheckButton" Content="{app:T others.updateCheck}" Classes="ghost" Margin="0,0,8,8" AutomationProperties.Name="{app:T others.updateCheck}" Click="OnUpdateCheckClick" />
                <Button x:Name="UpdateApplyButton" Content="{app:T others.updateApply}" Classes="ghost" Margin="0,0,8,8" AutomationProperties.Name="{app:T others.updateApply}" IsEnabled="False" Click="OnUpdateApplyClick" />
              </WrapPanel>
              <TextBlock x:Name="UpdateStatus" Foreground="#6E6E76" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 关于（首次打开时才创建，见 AboutView） -->
      <ContentControl x:Name="AboutHost" IsVisible="False" />
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Background="#131318" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#9A9AA3" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusBarRightText" Grid.Column="1" Text="GPL-3.0" FontSize="11" Foreground="#5C5C64" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
