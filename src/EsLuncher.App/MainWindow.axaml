<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EsLuncher.App"
        x:Class="EsLuncher.App.MainWindow"
        Title="ES Luncher"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E10">
  <Window.Styles>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#26262C" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C2C33" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="230,*">
    <Border Grid.Column="0" Background="#151519" Padding="20,24">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="ES Luncher" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
          <TextBlock Text="Endless Studio" FontSize="11" Foreground="#8A8A93" />
        </StackPanel>

        <ListBox x:Name="NavList"
                 Grid.Row="1"
                 Margin="0,28,0,0"
                 Background="Transparent"
                 SelectionChanged="OnNavChanged">
          <ListBoxItem Content="实例" Tag="instances" Height="38" />
          <ListBoxItem Content="下载" Tag="downloads" Height="38" />
          <ListBoxItem Content="设置" Tag="settings" Height="38" />
          <ListBoxItem Content="关于" Tag="about" Height="38" />
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="GPL-3.0 · 0.1.0-dev"
                   FontSize="11"
                   Foreground="#6E6E76" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="28">
      <!-- 实例页 -->
      <Grid x:Name="InstancesPage" RowDefinitions="Auto,*,Auto,Auto" ClipToBounds="True">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="实例" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
          <Button Content="刷新" Click="OnRefreshClick" />
          <Button Content="启动" Click="OnLaunchClick" />
          <Button Content="打开目录" Click="OnOpenFolderClick" />
          <Button Content="诊断" Click="OnDiagnosticsClick" />
          <Button Content="Modrinth" Click="OnModrinthClick" />
        </StackPanel>

        <ListBox x:Name="InstanceList" Grid.Row="1" Margin="0,18,0,0" Background="Transparent"
                 SelectionChanged="OnInstanceSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:InstanceItem">
              <Border Background="#1A1A1F" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9A9AA3" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Version}" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="#6E6E76" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="#141418" CornerRadius="10" Padding="14">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock x:Name="ContentTitle" Text="内容" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
              <ComboBox x:Name="ContentKindBox" SelectedIndex="0" Width="104" Margin="0,0,8,6" SelectionChanged="OnContentKindChanged">
                <ComboBoxItem Content="mods" />
                <ComboBoxItem Content="资源包" />
                <ComboBoxItem Content="光影" />
                <ComboBoxItem Content="世界" />
                <ComboBoxItem Content="数据包" />
              </ComboBox>
              <ComboBox x:Name="WorldBox" Width="140" Margin="0,0,8,6" IsVisible="False" SelectionChanged="OnWorldChanged" />
              <Button Content="添加" Margin="0,0,8,6" Click="OnAddContentClick" />
              <Button Content="启用/禁用" Margin="0,0,8,6" Click="OnToggleContentClick" />
              <Button Content="移除" Margin="0,0,8,6" Click="OnRemoveContentClick" />
              <Button Content="目录" Margin="0,0,8,6" Click="OnOpenContentFolderClick" />
              <Button Content="下载" Margin="0,0,8,6" Click="OnDownloadContentClick" />
            </WrapPanel>
            <ListBox x:Name="ContentList" Grid.Row="2" Height="132" Margin="0,6,0,0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:ContentItem">
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ContentStatus" Grid.Row="3" Margin="0,6,0,0" Foreground="#6E6E76" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="#9A9AA3" TextWrapping="Wrap" />
      </Grid>

      <!-- 下载页 -->
      <app:DownloadsView x:Name="DownloadsPage" IsVisible="False" />

      <!-- 设置页 -->
      <app:SettingsView x:Name="SettingsPage" IsVisible="False" />

      <!-- 关于页 -->
      <Grid x:Name="AboutPage" IsVisible="False">
        <StackPanel Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border CornerRadius="20" ClipToBounds="True" Width="132" Height="132" HorizontalAlignment="Center">
            <Image x:Name="StudioLogo" Width="132" Height="132" Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="Endless Studio" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
          <TextBlock Text="ES Luncher · GPL-3.0 · 0.1.0-dev"
                     FontSize="12"
                     Foreground="#9A9AA3"
                     HorizontalAlignment="Center" />
          <TextBlock Text="引擎 M0–M6 已完成：下载 / 启动 / Java 运行时 / 账号 / 实例 / 加载器"
                     FontSize="12"
                     Foreground="#6E6E76"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
