<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EsLuncher.App"
             x:Class="EsLuncher.App.ModrinthDownloadPanel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBox x:Name="QueryBox" Width="260" PlaceholderText="搜索（留空 = 直接浏览）" />
      <Button Content="搜索" Classes="ghost" Click="OnSearchClick" />
      <Button Content="详情" Classes="ghost" Click="OnDetailClick" />
      <TextBox x:Name="NameBox" Width="180" PlaceholderText="新实例名" IsVisible="False" />
      <Button x:Name="InstallButton" Content="安装选中" Classes="primary" Click="OnInstallClick" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="分类" Foreground="#9A9AA3" FontSize="12" VerticalAlignment="Center" />
      <ComboBox x:Name="CategoryBox" Width="160" SelectionChanged="OnFilterChanged" />
      <TextBlock Text="排序" Foreground="#9A9AA3" FontSize="12" VerticalAlignment="Center" />
      <ComboBox x:Name="SortBox" Width="150" SelectionChanged="OnFilterChanged">
        <ComboBoxItem Content="下载量" />
        <ComboBoxItem Content="相关度" />
        <ComboBoxItem Content="关注" />
        <ComboBoxItem Content="最新" />
        <ComboBoxItem Content="最近更新" />
      </ComboBox>
    </StackPanel>

    <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#9A9AA3" TextWrapping="Wrap" />

    <Border Grid.Row="3" Background="#141419" CornerRadius="12" Padding="10">
      <ListBox x:Name="HitsList" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:ModrinthItem">
            <Border Background="#1A1A22" CornerRadius="10" Padding="12" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="40" Height="40" CornerRadius="8" Background="#262631" IsVisible="{Binding HasNoIcon}">
                  <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Width="40" Height="40" IsVisible="{Binding HasIcon}" Source="{Binding Icon}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DownloadsText}" Foreground="#6E6E76" FontSize="10" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ProgressBar x:Name="ProgressBar" Grid.Row="4" Height="4" IsVisible="False" />
  </Grid>
</UserControl>
