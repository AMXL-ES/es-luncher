<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EsLuncher.App"
        x:Class="EsLuncher.App.AccountsWindow"
        Title="账户"
        Width="680"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E12">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="10">
    <TextBlock x:Name="TitleText" Text="账户" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
    <TextBlock Grid.Row="1" Text="离线账户免登录即可使用；微软登录将在后续版本提供"
               FontSize="11" Foreground="#8A8A93" TextWrapping="Wrap" />

    <Border Grid.Row="2" Background="#141419" CornerRadius="12" Padding="10">
      <ListBox x:Name="AccountsList" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:AccountItem">
            <Border Background="#1A1A22" CornerRadius="10" Padding="12" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="40" Height="40" CornerRadius="10" Background="#4C8DF6" IsVisible="{Binding HasNoAvatar}">
                  <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Width="40" Height="40" IsVisible="{Binding HasAvatar}" Source="{Binding Avatar}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <Border Background="#23232B" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#9A9AA3" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8A8A93" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding State}" FontSize="11" Foreground="#6E6E76" VerticalAlignment="Center" />
                  <Button Content="{app:T accounts.setDefault}" Tag="{Binding Key}" Click="OnSetDefaultClick" />
                  <Button Content="{app:T accounts.use}" Tag="{Binding Key}" Click="OnUseClick" />
                  <Button Content="{app:T accounts.delete}" Tag="{Binding Key}" Click="OnDeleteClick" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="3" Background="#141419" CornerRadius="12" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock Text="{app:T accounts.add}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" />
        <WrapPanel Orientation="Horizontal">
          <TextBox x:Name="UsernameBox" Width="220" Margin="0,0,10,6" PlaceholderText="{app:T accounts.username}" />
          <Button Content="{app:T accounts.addOffline}" Margin="0,0,10,6" Click="OnAddOfflineClick" />
          <Button Content="{app:T accounts.refreshAvatars}" Margin="0,0,10,6" Click="OnRefreshAvatarsClick" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" Foreground="#9A9AA3" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
      <Button Content="{app:T accounts.close}" IsCancel="True" Click="OnCloseClick" />
      <TextBlock x:Name="HintText" Foreground="#5C5C64" FontSize="11" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
