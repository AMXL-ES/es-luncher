<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EsLuncher.App.DiagnosticsWindow"
        Title="诊断"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E10">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <TextBlock x:Name="TitleText" Text="诊断" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
    <TextBlock x:Name="LogText" Grid.Row="1" Margin="0,6,0,0" Foreground="#8A8A93" FontSize="12" TextWrapping="Wrap" />

    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,14,0,0">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="错误行" Foreground="#9A9AA3" FontSize="12" />
        <ListBox x:Name="ErrorsList" Height="240" Background="Transparent" />
        <TextBlock Text="崩溃报告" Foreground="#9A9AA3" FontSize="12" Margin="0,10,0,0" />
        <ListBox x:Name="CrashesList" Height="90" Background="Transparent" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="提示" Foreground="#9A9AA3" FontSize="12" />
        <ListBox x:Name="HintsList" Height="340" Background="Transparent" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
      <Button Content="导出诊断包" Click="OnExportClick" />
      <Button Content="关闭" Click="OnCloseClick" />
      <TextBlock x:Name="StatusText" Foreground="#9A9AA3" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
