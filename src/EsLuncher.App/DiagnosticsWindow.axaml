<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EsLuncher.App"
        x:Class="EsLuncher.App.DiagnosticsWindow"
        Title="诊断"
        Width="760"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E10">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <TextBlock x:Name="TitleText" Text="诊断" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
    <TextBlock x:Name="LogText" Grid.Row="1" Margin="0,6,0,0" Foreground="#8A8A93" FontSize="12" TextWrapping="Wrap" />

    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,14,0,0">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{app:T diagnostics.errors}" Foreground="#9A9AA3" FontSize="12" />
        <TextBox x:Name="ErrorSearchBox" PlaceholderText="{app:T diagnostics.search}" Margin="0,4,0,4" TextChanged="OnErrorSearchChanged" />
        <ListBox x:Name="ErrorsList" Height="210" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#D0D0D6" Margin="0,0,0,4" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{app:T diagnostics.crashes}" Foreground="#9A9AA3" FontSize="12" Margin="0,10,0,0" />
        <ListBox x:Name="CrashesList" Height="90" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#8A8A93" Margin="0,0,0,4" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{app:T diagnostics.hints}" Foreground="#9A9AA3" FontSize="12" />
        <ListBox x:Name="HintsList" Height="300" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#D0D0D6" Margin="0,0,0,6" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
      <Button Content="{app:T diagnostics.export}" Click="OnExportClick" />
      <Button Content="{app:T diagnostics.fix}" Click="OnFixDependenciesClick" />
      <Button Content="{app:T diagnostics.close}" IsCancel="True" Click="OnCloseClick" />
      <TextBlock x:Name="StatusText" Foreground="#9A9AA3" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
