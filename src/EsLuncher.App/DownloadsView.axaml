<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EsLuncher.App"
             x:Class="EsLuncher.App.DownloadsView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="下载" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
      <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="OnFilterChanged">
        <ComboBoxItem Content="正式版" />
        <ComboBoxItem Content="快照" />
        <ComboBoxItem Content="全部" />
      </ComboBox>
      <Button Content="刷新清单" Click="OnRefreshClick" />
      <Button Content="下载选中" Click="OnDownloadClick" />
      <Button x:Name="CancelButton" Content="取消" Click="OnCancelClick" IsEnabled="False" />
    </StackPanel>

    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10,0,0" Foreground="#9A9AA3" TextWrapping="Wrap" />

    <ListBox x:Name="VersionList" Grid.Row="2" Margin="0,12,0,0" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="app:VersionItem">
          <Border Background="#1A1A1F" CornerRadius="8" Padding="12" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Id}" Foreground="#FFFFFF" />
              <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#6E6E76" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ProgressBar x:Name="ProgressBar" Grid.Row="3" Height="4" Margin="0,10,0,0" IsVisible="False" />
  </Grid>
</UserControl>
