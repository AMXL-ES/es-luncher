<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EsLuncher.App"
             x:Class="EsLuncher.App.DownloadsView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <TextBlock Text="{app:T downloads.title}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />

    <Border x:Name="ContextBorder" Grid.Row="1" Background="#141419" CornerRadius="12" Padding="12">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{app:T downloads.target}" Foreground="#9A9AA3" FontSize="12" VerticalAlignment="Center" />
          <ComboBox x:Name="InstanceCombo" Width="260" SelectionChanged="OnInstanceChanged" />
          <TextBlock Text="{app:T downloads.world}" Foreground="#9A9AA3" FontSize="12" VerticalAlignment="Center" />
          <ComboBox x:Name="WorldCombo" Width="180" SelectionChanged="OnWorldChanged" />
        </StackPanel>
        <TextBlock x:Name="ContextText" Foreground="#6E6E76" FontSize="11" />
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" SelectionChanged="OnTabChanged">
      <TabItem Header="{app:T downloads.versionTab}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0" RowSpacing="10">
          <Border Background="#141419" CornerRadius="12" Padding="14">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="FilterBox" SelectedIndex="0" Width="120" SelectionChanged="OnFilterChanged">
                  <ComboBoxItem Content="{app:T downloads.filter.release}" />
                  <ComboBoxItem Content="{app:T downloads.filter.snapshot}" />
                  <ComboBoxItem Content="{app:T downloads.filter.all}" />
                </ComboBox>
                <TextBlock Text="{app:T downloads.loader}" Foreground="#9A9AA3" VerticalAlignment="Center" />
                <ComboBox x:Name="LoaderBox" SelectedIndex="0" Width="120">
                  <ComboBoxItem Content="{app:T downloads.loader.none}" />
                  <ComboBoxItem Content="Fabric" />
                  <ComboBoxItem Content="Quilt" />
                  <ComboBoxItem Content="Forge" />
                </ComboBox>
                <TextBox x:Name="InstanceNameBox" Width="200" PlaceholderText="{app:T downloads.instanceName}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{app:T downloads.refresh}" AutomationProperties.Name="{app:T downloads.refresh}" Classes="ghost" Click="OnRefreshClick" />
                <Button Content="{app:T downloads.selected}" AutomationProperties.Name="{app:T downloads.selected}" Classes="ghost" Click="OnDownloadClick" />
                <Button Content="{app:T downloads.create}" AutomationProperties.Name="{app:T downloads.create}" Classes="primary" Click="OnDownloadAndCreateClick" />
                <Button x:Name="CancelButton" Content="{app:T downloads.cancel}" AutomationProperties.Name="{app:T downloads.cancel}" Classes="ghost" Click="OnCancelClick" IsEnabled="False" />
              </StackPanel>
              <TextBlock x:Name="StatusText" Foreground="#9A9AA3" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="#141419" CornerRadius="12" Padding="10">
            <ListBox x:Name="VersionList" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:VersionItem">
                  <Border Background="#1A1A22" CornerRadius="10" Padding="12" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Id}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" />
                      <Border Grid.Column="1" Background="#23232B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" Foreground="#9A9AA3" FontSize="10" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="4" IsVisible="False" />
        </Grid>
      </TabItem>

      <TabItem Header="{app:T downloads.modpackTab}">
        <app:ModrinthDownloadPanel x:Name="ModpackPanel" ModpackMode="True" Margin="0,10,0,0" />
      </TabItem>
      <TabItem Header="{app:T downloads.modsTab}">
        <app:ModrinthDownloadPanel x:Name="ModsPanel" Kind="Mods" Margin="0,10,0,0" />
      </TabItem>
      <TabItem Header="{app:T downloads.resourcepacksTab}">
        <app:ModrinthDownloadPanel x:Name="ResourcePacksPanel" Kind="ResourcePacks" Margin="0,10,0,0" />
      </TabItem>
      <TabItem Header="{app:T downloads.shadersTab}">
        <app:ModrinthDownloadPanel x:Name="ShadersPanel" Kind="ShaderPacks" Margin="0,10,0,0" />
      </TabItem>
      <TabItem Header="{app:T downloads.datapacksTab}">
        <app:ModrinthDownloadPanel x:Name="DatapacksPanel" Kind="Datapacks" Margin="0,10,0,0" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
